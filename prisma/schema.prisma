// Lara — language learning app
// Local dev runs against `prisma dev` (local Postgres); production points
// DATABASE_URL at Neon. Same provider, so nothing else changes.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Users & language profiles
// ---------------------------------------------------------------------------

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profiles           LanguageProfile[]
  decks              Deck[]
  cards              Card[]
  reviews            Review[]
  articles           Article[]
  messages           CardChatMessage[]
  speakConversations SpeakConversation[]
}

/// One per language a user is learning. Holds the level used to pitch
/// AI-generated immersion content one notch above the learner (i+1).
model LanguageProfile {
  id             String    @id @default(cuid())
  userId         String
  targetLanguage String // ISO 639-1, e.g. "sv"
  sourceLanguage String    @default("en")
  level          CefrLevel @default(A1)

  // Daily study caps, mirroring Anki's deck options
  dailyNewLimit    Int @default(20)
  dailyReviewLimit Int @default(200)

  // ElevenLabs voice for this language; falls back to the configured default
  voiceId String?

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  decks              Deck[]
  articles           Article[]
  speakConversations SpeakConversation[]

  @@unique([userId, targetLanguage])
  @@index([userId])
}

enum CefrLevel {
  A1
  A2
  B1
  B2
  C1
  C2
}

// ---------------------------------------------------------------------------
// Decks & cards
// ---------------------------------------------------------------------------

model Deck {
  id          String  @id @default(cuid())
  userId      String
  profileId   String
  name        String
  description String?
  emoji       String?
  sortOrder   Int     @default(0)

  /// Set when this deck was produced by an AI prompt, so it can be extended
  /// later with the same intent.
  sourcePrompt String?

  /// Which way new cards in this deck face by default. Each card still carries
  /// its own `cardType`, so a deck can mix directions (imported Anki decks do).
  direction CardDirection @default(RECOGNITION)

  /// New cards this deck introduces per study day (Anki's "New cards/day").
  /// Counts only this deck's own cards. Reviews are never capped.
  newCardsPerDay Int @default(5)

  /// Set when the learner archived this deck: it and everything beneath it
  /// drop out of study, counts and the main deck list, without losing cards
  /// or history. Archiving/unarchiving always applies to the whole subtree,
  /// so queries only ever need to check the deck's own column.
  archivedAt DateTime?

  /// Anki deck id, for decks brought over by `scripts/import-anki.ts`.
  ankiId BigInt?

  /// Folder this deck sits in, like Anki's "Parent::Child". A deck can hold
  /// cards *and* subdecks; studying it includes everything beneath it.
  /// Deleting a deck deletes its subdecks, as in Anki.
  parentId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  profile            LanguageProfile     @relation(fields: [profileId], references: [id], onDelete: Cascade)
  parent             Deck?               @relation("DeckTree", fields: [parentId], references: [id], onDelete: Cascade)
  children           Deck[]              @relation("DeckTree")
  cards              Card[]
  /// Stories written around this deck's vocabulary.
  articles           Article[]
  /// Speak conversations that wove in this deck's words.
  speakConversations SpeakConversation[]

  @@index([userId])
  @@index([profileId])
  @@index([parentId])
}

model Card {
  id     String @id @default(cuid())
  userId String
  deckId String

  // ---- Content ----
  target         String // the word/phrase in the target language
  source         String // its translation
  targetSentence String? // example sentence in the target language
  sourceSentence String? // that sentence translated
  notes          String? // grammar / usage note
  cardType       CardType @default(RECOGNITION)
  tags           String[] @default([])

  // ---- Media ----
  imageUrl         String?
  audioUrl         String? // audio for `target`
  sentenceAudioUrl String? // audio for `targetSentence`

  // ---- FSRS scheduling state (see src/lib/srs) ----
  state         FsrsState @default(NEW)
  due           DateTime  @default(now())
  stability     Float     @default(0)
  difficulty    Float     @default(0)
  elapsedDays   Int       @default(0)
  scheduledDays Int       @default(0)
  reps          Int       @default(0)
  lapses        Int       @default(0)
  learningSteps Int       @default(0)
  lastReview    DateTime?

  suspended Boolean  @default(false)

  /// Anki card id, for cards brought over by `scripts/import-anki.ts`.
  /// Unique per user only: two Anki profiles can share ids.
  ankiId BigInt?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  deck     Deck             @relation(fields: [deckId], references: [id], onDelete: Cascade)
  reviews  Review[]
  messages CardChatMessage[]

  @@unique([userId, ankiId])
  @@index([deckId, due])
  @@index([userId, due])
  @@index([deckId, state])
}

/// A question the learner asked about one specific card, and the answer.
/// Persisted so that a conjugation table or usage explanation you asked for
/// once is still there the next time the card comes up.
model CardChatMessage {
  id     String @id @default(cuid())
  cardId String
  userId String

  role    ChatRole
  content String

  createdAt DateTime @default(now())

  card Card @relation(fields: [cardId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([cardId, createdAt])
}

enum ChatRole {
  USER
  ASSISTANT
}

enum CardType {
  /// See target -> recall meaning
  RECOGNITION
  /// See source -> produce target
  PRODUCTION
  /// Sentence with the target word blanked out
  CLOZE
  /// Type the target from memory
  TYPING
  /// See the picture (`imageUrl`) -> produce target
  PICTURE
}

/// The default facing for cards added to a deck. BOTH adds one RECOGNITION
/// and one PRODUCTION card per word, like Anki's "Basic (and reversed card)".
enum CardDirection {
  RECOGNITION
  PRODUCTION
  BOTH
}

enum FsrsState {
  NEW
  LEARNING
  REVIEW
  RELEARNING
}

/// Immutable log of every answer. Keeping the full history is what makes it
/// possible to re-optimise FSRS parameters against real performance later.
model Review {
  id     String @id @default(cuid())
  cardId String
  userId String

  rating Int // 1 = Again, 2 = Hard, 3 = Good, 4 = Easy

  // Card state snapshot produced by this review
  state           FsrsState
  due             DateTime
  stability       Float
  difficulty      Float
  elapsedDays     Int
  lastElapsedDays Int
  scheduledDays   Int

  durationMs Int? // time spent on the card
  reviewedAt DateTime @default(now())

  /// Anki revlog id for history imported from Anki; null for reviews done in
  /// Lara. The importer uses this to refuse wiping Lara-native progress.
  /// Unique per user only: Anki revlog ids are millisecond timestamps, and two
  /// profiles studied on one device do collide.
  ankiId BigInt?

  card Card @relation(fields: [cardId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, ankiId])
  @@index([userId, reviewedAt])
  @@index([cardId, reviewedAt])
}

// ---------------------------------------------------------------------------
// Immersion articles
// ---------------------------------------------------------------------------

model Article {
  id        String @id @default(cuid())
  userId    String
  profileId String

  title           String
  titleTranslated String?
  topic           String?
  /// Level the text was written for — normally one step above the profile.
  level           CefrLevel
  status          ArticleStatus @default(DRAFT)
  /// Narrative fiction vs. non-fiction piece. Changes how it is written and
  /// where it is listed, but both use the same reader.
  kind            ContentKind   @default(ARTICLE)

  /// Full text in the target language, kept alongside the per-sentence
  /// segments so the reader can render prose without stitching.
  body String

  audioUrl  String?
  wordCount Int     @default(0)

  /// Words pulled from the learner's existing cards that this text reuses.
  reusedVocabulary String[] @default([])
  /// New words deliberately introduced by this text (the "+1").
  newVocabulary    String[] @default([])

  sourcePrompt String?
  /// Deck whose vocabulary the story was built around; null for stories drawn
  /// from all of the learner's cards. Kept (as null) if the deck is deleted.
  deckId       String?
  readAt       DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  profile  LanguageProfile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  deck     Deck?            @relation(fields: [deckId], references: [id], onDelete: SetNull)
  segments ArticleSegment[]

  @@index([userId, createdAt])
  @@index([profileId, kind])
}

enum ArticleStatus {
  DRAFT
  READY
  FAILED
}

enum ContentKind {
  ARTICLE
  STORY
}

/// One sentence of an article. Powers tap-to-translate and sentence-level
/// audio in the reader.
model ArticleSegment {
  id        String @id @default(cuid())
  articleId String
  index     Int

  target      String
  translation String
  audioUrl    String?

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([articleId, index])
  @@index([articleId])
}

// ---------------------------------------------------------------------------
// Speak: voice conversations with the tutor
// ---------------------------------------------------------------------------

/// One finished Speak conversation: what was said and the corrections shown.
/// Kept so a later version can turn a correction into a card.
model SpeakConversation {
  id        String  @id @default(cuid())
  userId    String
  profileId String
  /// Deck whose words were woven in; kept (as null) if the deck is deleted.
  deckId    String?
  topic     String

  /// ElevenLabs' id for the call, to find it on their side.
  externalId  String?
  /// [{ role: "user" | "agent", text }], in order.
  transcript  Json
  /// [{ said, better, explanation }], in order.
  corrections Json

  createdAt DateTime @default(now())

  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  profile LanguageProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  deck    Deck?           @relation(fields: [deckId], references: [id], onDelete: SetNull)

  @@index([profileId, createdAt])
}
