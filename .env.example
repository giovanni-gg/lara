# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Local development: run `npm run db:dev` and paste the two URLs it prints.
# It starts a real local Postgres — no Docker, no install.
# Production: replace both with your Neon connection string.
DATABASE_URL=""
SHADOW_DATABASE_URL=""

# ---------------------------------------------------------------------------
# AI — card & article generation
# ---------------------------------------------------------------------------
# Either one works. With ANTHROPIC_API_KEY set the app calls Anthropic
# directly; otherwise it routes through the Vercel AI Gateway.
ANTHROPIC_API_KEY=""
AI_GATEWAY_API_KEY=""

# ---------------------------------------------------------------------------
# Text to speech (optional — the app works without it, just silently)
# ---------------------------------------------------------------------------
ELEVENLABS_API_KEY=""
ELEVENLABS_MODEL_ID="eleven_turbo_v2_5"

# ---------------------------------------------------------------------------
# Media storage
# ---------------------------------------------------------------------------
# "local" writes audio to .media/ and serves it from /api/media.
# Switch to Vercel Blob in production by setting BLOB_READ_WRITE_TOKEN.
MEDIA_STORAGE="local"
BLOB_READ_WRITE_TOKEN=""

# Optional: the single local account the app uses until real auth lands.
LARA_USER_EMAIL="you@lara.local"
